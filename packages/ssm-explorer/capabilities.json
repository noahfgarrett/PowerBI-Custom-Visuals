{
  "dataRoles": [
    {
      "name": "project",
      "displayName": "Project",
      "description": "Project identity shared by registry rows.",
      "displayNameKey": "Ssm_role_project",
      "descriptionKey": "Ssm_role_project_description",
      "kind": "Grouping"
    },
    {
      "name": "equipmentId",
      "displayName": "Equipment ID",
      "description": "Stable equipment tag within its project.",
      "displayNameKey": "Ssm_role_equipmentId",
      "descriptionKey": "Ssm_role_equipmentId_description",
      "kind": "Grouping"
    },
    {
      "name": "equipmentLabel",
      "displayName": "Equipment label",
      "description": "Description or display label.",
      "displayNameKey": "Ssm_role_equipmentLabel",
      "descriptionKey": "Ssm_role_equipmentLabel_description",
      "kind": "Grouping"
    },
    {
      "name": "nodeType",
      "displayName": "Record type",
      "description": "Equipment or Header. Blank defaults to Equipment.",
      "displayNameKey": "Ssm_role_nodeType",
      "descriptionKey": "Ssm_role_nodeType_description",
      "kind": "Grouping"
    },
    {
      "name": "discipline",
      "displayName": "Discipline",
      "description": "Equipment discipline.",
      "displayNameKey": "Ssm_role_discipline",
      "descriptionKey": "Ssm_role_discipline_description",
      "kind": "Grouping"
    },
    {
      "name": "parentMilestone",
      "displayName": "Parent milestone",
      "description": "L1 identity or code.",
      "displayNameKey": "Ssm_role_parentMilestone",
      "descriptionKey": "Ssm_role_parentMilestone_description",
      "kind": "Grouping"
    },
    {
      "name": "milestone",
      "displayName": "Milestone",
      "description": "L2 identity or code.",
      "displayNameKey": "Ssm_role_milestone",
      "descriptionKey": "Ssm_role_milestone_description",
      "kind": "Grouping"
    },
    {
      "name": "closestParent",
      "displayName": "Closest parent",
      "description": "Equipment tag or system root.",
      "displayNameKey": "Ssm_role_closestParent",
      "descriptionKey": "Ssm_role_closestParent_description",
      "kind": "Grouping"
    },
    {
      "name": "closestParentProject",
      "displayName": "Closest parent project",
      "description": "Optional target project. Blank uses the row project.",
      "displayNameKey": "Ssm_role_closestParentProject",
      "descriptionKey": "Ssm_role_closestParentProject_description",
      "kind": "Grouping"
    },
    {
      "name": "dependencies",
      "displayName": "Dependencies",
      "description": "Tags separated by semicolons or newlines, or a JSON array.",
      "displayNameKey": "Ssm_role_dependencies",
      "descriptionKey": "Ssm_role_dependencies_description",
      "kind": "Grouping"
    },
    {
      "name": "dependencyProject",
      "displayName": "Dependency project",
      "description": "Optional target project, or aligned project list.",
      "displayNameKey": "Ssm_role_dependencyProject",
      "descriptionKey": "Ssm_role_dependencyProject_description",
      "kind": "Grouping"
    },
    {
      "name": "systemName",
      "displayName": "System name",
      "description": "Distinguishes system roots from unresolved equipment.",
      "displayNameKey": "Ssm_role_systemName",
      "descriptionKey": "Ssm_role_systemName_description",
      "kind": "Grouping"
    },
    {
      "name": "status",
      "displayName": "Status",
      "description": "Optional equipment status: Not Started, In Progress, or Completed. Unknown and conflicting values remain explicit.",
      "displayNameKey": "Ssm_role_status",
      "descriptionKey": "Ssm_role_status_description",
      "kind": "Grouping"
    },
    {
      "name": "nodeDetail",
      "displayName": "Equipment details",
      "description": "Optional fields for equipment and header panels.",
      "displayNameKey": "Ssm_role_nodeDetail",
      "descriptionKey": "Ssm_role_nodeDetail_description",
      "kind": "Grouping"
    },
    {
      "name": "milestoneDetail",
      "displayName": "Milestone details",
      "description": "Optional fields describing L2 milestones.",
      "displayNameKey": "Ssm_role_milestoneDetail",
      "descriptionKey": "Ssm_role_milestoneDetail_description",
      "kind": "Grouping"
    },
    {
      "name": "parentMilestoneDetail",
      "displayName": "Parent milestone details",
      "description": "Optional fields describing L1 milestones.",
      "displayNameKey": "Ssm_role_parentMilestoneDetail",
      "descriptionKey": "Ssm_role_parentMilestoneDetail_description",
      "kind": "Grouping"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "project": {
            "max": 1
          },
          "equipmentId": {
            "max": 1
          },
          "equipmentLabel": {
            "max": 1
          },
          "nodeType": {
            "max": 1
          },
          "discipline": {
            "max": 1
          },
          "parentMilestone": {
            "max": 1
          },
          "milestone": {
            "max": 1
          },
          "closestParent": {
            "max": 1
          },
          "closestParentProject": {
            "max": 1
          },
          "dependencies": {
            "max": 1
          },
          "dependencyProject": {
            "max": 1
          },
          "systemName": {
            "max": 1
          },
          "status": {
            "max": 1
          },
          "nodeDetail": {
            "max": 32
          },
          "milestoneDetail": {
            "max": 32
          },
          "parentMilestoneDetail": {
            "max": 32
          }
        }
      ],
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "project"
              }
            },
            {
              "for": {
                "in": "equipmentId"
              }
            },
            {
              "for": {
                "in": "equipmentLabel"
              }
            },
            {
              "for": {
                "in": "nodeType"
              }
            },
            {
              "for": {
                "in": "discipline"
              }
            },
            {
              "for": {
                "in": "parentMilestone"
              }
            },
            {
              "for": {
                "in": "milestone"
              }
            },
            {
              "for": {
                "in": "closestParent"
              }
            },
            {
              "for": {
                "in": "closestParentProject"
              }
            },
            {
              "for": {
                "in": "dependencies"
              }
            },
            {
              "for": {
                "in": "dependencyProject"
              }
            },
            {
              "for": {
                "in": "systemName"
              }
            },
            {
              "for": {
                "in": "status"
              }
            },
            {
              "for": {
                "in": "nodeDetail"
              }
            },
            {
              "for": {
                "in": "milestoneDetail"
              }
            },
            {
              "for": {
                "in": "parentMilestoneDetail"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 2000
            }
          }
        }
      }
    }
  ],
