{
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Step labels (e.g., Revenue, +Sales, -Costs, =Profit)"
    },
    {
      "displayName": "Measure",
      "name": "measure",
      "kind": "Measure",
      "description": "Step values (positive = increase, negative = decrease)"
    },
    {
      "displayName": "Is Total",
      "name": "isTotal",
      "kind": "Measure",
      "description": "Optional flag (1 = total bar, 0 = incremental). If not provided, last bar auto-detected as total."
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "measure": {
            "max": 1
          },
          "isTotal": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 500
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            },
            {
              "bind": {
                "to": "isTotal"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
