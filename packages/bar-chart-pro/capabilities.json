{
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "X-axis categories (e.g., Work Week)"
    },
    {
      "displayName": "Sub-Category",
      "name": "subCategory",
      "kind": "Grouping",
      "description": "Drill-down sub-category (optional)"
    },
    {
      "displayName": "Values",
      "name": "values",
      "kind": "Measure",
      "description": "Bar values — supports multiple for grouped/stacked"
    },
    {
      "displayName": "Line Values",
      "name": "lineValues",
      "kind": "Measure",
      "description": "Line overlay measures for combo mode"
    },
    {
      "displayName": "Target",
      "name": "target",
      "kind": "Measure",
      "description": "Target/reference line value"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "subCategory": {
            "max": 1
          },
          "values": {
            "max": 10
          },
          "lineValues": {
            "max": 5
          },
          "target": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            },
            {
              "for": {
                "in": "subCategory"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 500
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "values"
              }
            },
            {
              "bind": {
                "to": "lineValues"
              }
            },
            {
              "bind": {
                "to": "target"
              }
            }
          ]
        }
      }
    }
  ],
