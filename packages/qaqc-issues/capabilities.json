{
  "dataRoles": [
    {
      "name": "id",
      "kind": "Grouping",
      "displayName": "ID",
      "displayNameKey": "Qaqc_role_id",
      "description": "Issue ID, for example #1024.",
      "descriptionKey": "Qaqc_role_id_description"
    },
    {
      "name": "title",
      "kind": "Grouping",
      "displayName": "Title",
      "displayNameKey": "Qaqc_role_title",
      "description": "Short description of the issue.",
      "descriptionKey": "Qaqc_role_title_description"
    },
    {
      "name": "status",
      "kind": "Grouping",
      "displayName": "Status",
      "displayNameKey": "Qaqc_role_status",
      "description": "Issue status, for example Open, Closed or Void. Void issues are excluded.",
      "descriptionKey": "Qaqc_role_status_description"
    },
    {
      "name": "type",
      "kind": "Grouping",
      "displayName": "Type",
      "displayNameKey": "Qaqc_role_type",
      "description": "Issue type, for example COR or NCR.",
      "descriptionKey": "Qaqc_role_type_description"
    },
    {
      "name": "contractor",
      "kind": "Grouping",
      "displayName": "Contractor",
      "displayNameKey": "Qaqc_role_contractor",
      "description": "Contractor responsible for the issue.",
      "descriptionKey": "Qaqc_role_contractor_description"
    },
    {
      "name": "createdOn",
      "kind": "Grouping",
      "displayName": "Created On",
      "displayNameKey": "Qaqc_role_createdOn",
      "description": "Date the issue was created. Sets the work week it was opened.",
      "descriptionKey": "Qaqc_role_createdOn_description"
    },
    {
      "name": "updatedOn",
      "kind": "Grouping",
      "displayName": "Updated On",
      "displayNameKey": "Qaqc_role_updatedOn",
      "description": "Date the issue was last updated. A closed issue counts as closed on this date.",
      "descriptionKey": "Qaqc_role_updatedOn_description"
    },
    {
      "name": "dueDate",
      "kind": "Grouping",
      "displayName": "Due Date",
      "displayNameKey": "Qaqc_role_dueDate",
      "description": "Date the issue is due.",
      "descriptionKey": "Qaqc_role_dueDate_description"
    },
    {
      "name": "createdBy",
      "kind": "Grouping",
      "displayName": "Created By",
      "displayNameKey": "Qaqc_role_createdBy",
      "description": "Who created the issue. Issues created by LotusWorks are counted unless Created By (Company) picks others.",
      "descriptionKey": "Qaqc_role_createdBy_description"
    },
    {
      "name": "rootCause",
      "kind": "Grouping",
      "displayName": "Root Cause",
      "displayNameKey": "Qaqc_role_rootCause",
      "description": "Optional. The Root Cause column; adds the Issues by Root Cause Pareto.",
      "descriptionKey": "Qaqc_role_rootCause_description"
    },
    {
      "name": "rootCauseCategory",
      "kind": "Grouping",
      "displayName": "Root Cause Category",
      "displayNameKey": "Qaqc_role_rootCauseCategory",
      "description": "Optional. The Root Cause Category column; adds the category panel to the Issues by Root Cause Pareto.",
      "descriptionKey": "Qaqc_role_rootCauseCategory_description"
    },
    {
      "name": "bim360CreatedBy",
      "kind": "Grouping",
      "displayName": "BIM360 Created By",
      "displayNameKey": "Qaqc_role_bim360CreatedBy",
      "description": "Optional. The enriched Autodesk export BIM360_Created By column. For an issue migrated from BIM 360, it decides whether LotusWorks created the issue.",
      "descriptionKey": "Qaqc_role_bim360CreatedBy_description"
    },
    {
      "name": "bim360CreatedOn",
      "kind": "Grouping",
      "displayName": "BIM360 Created On",
      "displayNameKey": "Qaqc_role_bim360CreatedOn",
      "description": "Optional. The enriched Autodesk export BIM360_Created On column. A migrated issue counts as opened on this date instead of Created On.",
      "descriptionKey": "Qaqc_role_bim360CreatedOn_description"
    },
    {
      "name": "bim360ClosedOn",
      "kind": "Grouping",
      "displayName": "BIM360 Closed On",
      "displayNameKey": "Qaqc_role_bim360ClosedOn",
      "description": "Optional. The enriched Autodesk export BIM360_Closed On column. A migrated closed issue counts as closed on this date instead of Closed At or Updated On.",
      "descriptionKey": "Qaqc_role_bim360ClosedOn_description"
    },
    {
      "name": "closedAt",
      "kind": "Grouping",
      "displayName": "Closed At",
      "displayNameKey": "Qaqc_role_closedAt",
      "description": "Optional. The enriched Autodesk export Closed at column. A closed issue counts as closed on this date instead of Updated On.",
      "descriptionKey": "Qaqc_role_closedAt_description"
    },
    {
      "name": "createdByCompany",
      "kind": "Grouping",
      "displayName": "Created By (Company)",
      "displayNameKey": "Qaqc_role_createdByCompany",
      "description": "Optional. The enriched Autodesk export Created By (Company) column. Adds a Filter menu choice to show other companies' issues; LotusWorks stays the default.",
      "descriptionKey": "Qaqc_role_createdByCompany_description"
    },
    {
      "name": "discipline",
      "kind": "Grouping",
      "displayName": "Discipline",
      "displayNameKey": "Qaqc_role_discipline",
      "description": "Optional. The Discipline column; adds Discipline to the Filter menu.",
      "descriptionKey": "Qaqc_role_discipline_description"
    },
    {
      "name": "source",
      "kind": "Grouping",
      "displayName": "Source",
      "displayNameKey": "Qaqc_role_source",
      "description": "Optional. The QCx Combined Source column. Bound, only BIM rows count as issues and the NCR Pass Rate card appears, reading Electrical and Mechanical rows. Leave it empty for the Issues export.",
      "descriptionKey": "Qaqc_role_source_description"
    },
    {
      "name": "rowId",
      "kind": "Grouping",
      "displayName": "Row ID",
      "displayNameKey": "Qaqc_role_rowId",
      "description": "Optional. The QCx Combined Row ID column. Bind it with Source: it keeps identical inspection rows from merging, so NCR Pass Rate counts every final.",
      "descriptionKey": "Qaqc_role_rowId_description"
    },
    {
      "name": "workWeek",
      "kind": "Grouping",
      "displayName": "Work Week",
      "displayNameKey": "Qaqc_role_workWeek",
      "description": "Optional. The QCx Combined Work Week column; NCR Pass Rate needs it.",
      "descriptionKey": "Qaqc_role_workWeek_description"
    },
    {
      "name": "phase",
      "kind": "Grouping",
      "displayName": "Inspection Phase",
      "displayNameKey": "Qaqc_role_phase",
      "description": "Optional. The QCx Combined Inspection Phase column; NCR Pass Rate needs it.",
      "descriptionKey": "Qaqc_role_phase_description"
    },
    {
      "name": "issue",
      "kind": "Grouping",
      "displayName": "Issue",
      "displayNameKey": "Qaqc_role_issue",
      "description": "Optional. The QCx Combined Issue column, which marks an inspection with an issue found; NCR Pass Rate needs it.",
      "descriptionKey": "Qaqc_role_issue_description"
    }
  ],
