{
  "dataRoles": [
    {
      "name": "id",
      "kind": "Grouping",
      "displayName": "ID",
      "displayNameKey": "Qaqc_role_id",
      "description": "Issue ID, for example #1024.",
      "descriptionKey": "Qaqc_role_id_description"
    },
    {
      "name": "title",
      "kind": "Grouping",
      "displayName": "Title",
      "displayNameKey": "Qaqc_role_title",
      "description": "Short description of the issue.",
      "descriptionKey": "Qaqc_role_title_description"
    },
    {
      "name": "status",
      "kind": "Grouping",
      "displayName": "Status",
      "displayNameKey": "Qaqc_role_status",
      "description": "Issue status, for example Open, Closed or Void. Void issues are excluded.",
      "descriptionKey": "Qaqc_role_status_description"
    },
    {
      "name": "type",
      "kind": "Grouping",
      "displayName": "Type",
      "displayNameKey": "Qaqc_role_type",
      "description": "Issue type, for example COR or NCR.",
      "descriptionKey": "Qaqc_role_type_description"
    },
    {
      "name": "contractor",
      "kind": "Grouping",
      "displayName": "Contractor",
      "displayNameKey": "Qaqc_role_contractor",
      "description": "Contractor responsible for the issue.",
      "descriptionKey": "Qaqc_role_contractor_description"
    },
    {
      "name": "createdOn",
      "kind": "Grouping",
      "displayName": "Created On",
      "displayNameKey": "Qaqc_role_createdOn",
      "description": "Date the issue was created. Sets the work week it was opened.",
      "descriptionKey": "Qaqc_role_createdOn_description"
    },
    {
      "name": "updatedOn",
      "kind": "Grouping",
      "displayName": "Updated On",
      "displayNameKey": "Qaqc_role_updatedOn",
      "description": "Date the issue was last updated. A closed issue counts as closed on this date.",
      "descriptionKey": "Qaqc_role_updatedOn_description"
    },
    {
      "name": "dueDate",
      "kind": "Grouping",
      "displayName": "Due Date",
      "displayNameKey": "Qaqc_role_dueDate",
      "description": "Date the issue is due.",
      "descriptionKey": "Qaqc_role_dueDate_description"
    },
    {
      "name": "createdBy",
      "kind": "Grouping",
      "displayName": "Created By",
      "displayNameKey": "Qaqc_role_createdBy",
      "description": "Who created the issue. Only issues created by LotusWorks are counted.",
      "descriptionKey": "Qaqc_role_createdBy_description"
    },
    {
      "name": "rootCause",
      "kind": "Grouping",
      "displayName": "Root Cause",
      "displayNameKey": "Qaqc_role_rootCause",
      "description": "Optional. The BIM Issues Log Root Cause column; adds the Issues by Root Cause Pareto.",
      "descriptionKey": "Qaqc_role_rootCause_description"
    },
    {
      "name": "rootCauseCategory",
      "kind": "Grouping",
      "displayName": "Root Cause Category",
      "displayNameKey": "Qaqc_role_rootCauseCategory",
      "description": "Optional. The BIM Issues Log Root Cause Category column; adds the category panel to the Issues by Root Cause Pareto.",
      "descriptionKey": "Qaqc_role_rootCauseCategory_description"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "id": {
            "max": 1
          },
          "title": {
            "max": 1
          },
          "status": {
            "max": 1
          },
          "type": {
            "max": 1
          },
          "contractor": {
            "max": 1
          },
          "createdOn": {
            "max": 1
          },
          "updatedOn": {
            "max": 1
          },
          "dueDate": {
            "max": 1
          },
          "createdBy": {
            "max": 1
          },
          "rootCause": {
            "max": 1
          },
          "rootCauseCategory": {
            "max": 1
          }
        }
      ],
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "id"
              }
            },
            {
              "for": {
                "in": "title"
              }
            },
            {
              "for": {
                "in": "status"
              }
            },
            {
              "for": {
                "in": "type"
              }
            },
            {
              "for": {
                "in": "contractor"
              }
            },
            {
              "for": {
                "in": "createdOn"
              }
            },
            {
              "for": {
                "in": "updatedOn"
              }
            },
            {
              "for": {
                "in": "dueDate"
              }
            },
            {
              "for": {
                "in": "createdBy"
              }
            },
            {
              "for": {
                "in": "rootCause"
              }
            },
            {
              "for": {
                "in": "rootCauseCategory"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 30000
            }
          }
        }
      }
    }
  ],
  "objects": {
    "colors": {
      "displayName": "Colors",
      "displayNameKey": "Qaqc_colors",
      "properties": {
        "preset": {
          "displayName": "Preset",
          "displayNameKey": "Qaqc_colors_preset",
          "type": {
            "enumeration": [
              {
                "value": "qaqc",
                "displayName": "QCx",
                "displayNameKey": "Qaqc_preset_qaqc"
              },
              {
                "value": "blue",
                "displayName": "Blue",
                "displayNameKey": "Qaqc_preset_blue"
              },
              {
                "value": "lotusworks",
                "displayName": "LotusWorks",
                "displayNameKey": "Qaqc_preset_lotusworks"
              },
              {
                "value": "grayscale",
                "displayName": "Grayscale",
                "displayNameKey": "Qaqc_preset_grayscale"
              }
            ]
          }
        }
      }
    },
    "cardSettings": {
      "displayName": "Background",
      "displayNameKey": "Qaqc_background",
      "properties": {
        "backgroundColor": {
          "displayName": "Background color",
          "displayNameKey": "Qaqc_background_color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "backgroundOpacity": {
          "displayName": "Background opacity",
          "displayNameKey": "Qaqc_background_opacity",
          "type": {
            "numeric": true
          }
        },
        "cardOpacity": {
          "displayName": "Card opacity",
          "displayNameKey": "Qaqc_card_opacity",
          "type": {
            "numeric": true
          }
        }
      }
    },
    "animationSettings": {
      "displayName": "Animation",
      "displayNameKey": "Qaqc_animation",
      "properties": {
        "enabled": {
          "displayName": "Transitions",
          "displayNameKey": "Qaqc_animation_enabled",
          "type": {
            "bool": true
          }
        }
      }
    },
    "accessibility": {
      "displayName": "Accessibility",
      "displayNameKey": "Qaqc_accessibility",
      "properties": {
        "chartSummaries": {
          "displayName": "Screen reader chart summaries",
          "displayNameKey": "Qaqc_accessibility_summaries",
          "type": {
            "bool": true
          }
        }
      }
    }
  },
  "tooltips": {
    "supportedTypes": {
      "default": true
    },
    "supportEnhancedTooltips": true
  },
  "supportsEmptyDataView": true,
  "supportsKeyboardFocus": true,
  "privileges": []
}
