{
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Category labels for each box plot group"
    },
    {
      "displayName": "Values",
      "name": "values",
      "kind": "Measure",
      "description": "Raw values — the visual computes min/Q1/median/Q3/max internally"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "values": {
            "max": 10
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 1000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "values"
              }
            }
          ]
        }
      }
    }
  ],
