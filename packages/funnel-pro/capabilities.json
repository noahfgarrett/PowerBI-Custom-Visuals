{
  "dataRoles": [
    {
      "displayName": "Stage",
      "name": "category",
      "kind": "Grouping",
      "description": "Funnel stage names (e.g., Leads, Qualified, Proposal, Won)"
    },
    {
      "displayName": "Value",
      "name": "measure",
      "kind": "Measure",
      "description": "Numeric value per funnel stage"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "measure": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 12
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
    "funnelSettings": {
      "displayName": "Funnel Settings",
      "properties": {
        "style": {
          "displayName": "Style",
          "type": {
            "enumeration": [
              {
                "value": "symmetric",
                "displayName": "Symmetric"
              },
              {
                "value": "leftAligned",
                "displayName": "Left Aligned"
              }
            ]
          }
        },
        "showConversionRate": {
          "displayName": "Show Conversion Rate",
          "type": {
            "bool": true
          }
        },
        "gap": {
          "displayName": "Gap",
