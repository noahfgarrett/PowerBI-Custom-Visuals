{
  "dataRoles": [
    {
      "displayName": "Stage",
      "name": "category",
      "kind": "Grouping",
      "description": "Funnel stage names (e.g., Leads, Qualified, Proposal, Won)"
    },
    {
      "displayName": "Value",
      "name": "measure",
      "kind": "Measure",
      "description": "Numeric value per funnel stage"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "measure": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 12
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            }
          ]
        }
      }
    }
  ],
