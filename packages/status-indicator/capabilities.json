{
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "KPI names"
    },
    {
      "displayName": "Value",
      "name": "measure",
      "kind": "Measure",
      "description": "Current value"
    },
    {
      "displayName": "Warning Threshold",
      "name": "warningThreshold",
      "kind": "Measure",
      "description": "Warning threshold"
    },
    {
      "displayName": "Critical Threshold",
      "name": "criticalThreshold",
      "kind": "Measure",
      "description": "Critical threshold"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "measure": {
            "max": 1
          },
          "warningThreshold": {
            "max": 1
          },
          "criticalThreshold": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "category"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 100
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            },
            {
              "bind": {
                "to": "warningThreshold"
              }
            },
            {
              "bind": {
                "to": "criticalThreshold"
              }
            }
          ]
        }
      }
    }
  ],
