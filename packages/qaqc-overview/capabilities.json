                "value": "qaqc",
                "displayName": "QCx",
                "displayNameKey": "Qaqc_preset_qaqc"
              },
              {
                "value": "blue",
                "displayName": "Blue",
                "displayNameKey": "Qaqc_preset_blue"
              },
              {
