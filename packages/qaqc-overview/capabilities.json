{
  "dataRoles": [
    {
      "name": "source",
      "kind": "Grouping",
      "displayName": "Source",
      "displayNameKey": "Qaqc_role_source",
      "description": "Electrical, Mechanical, Welding or BIM: which sheet the row came from. Other values are skipped.",
      "descriptionKey": "Qaqc_role_source_description"
    },
    {
      "name": "rowId",
      "kind": "Grouping",
      "displayName": "Row ID",
      "displayNameKey": "Qaqc_role_rowId",
      "description": "Required unique row number (the QCx Combined Row ID index column). Keeps identical rows separate.",
      "descriptionKey": "Qaqc_role_rowId_description"
    },
    {
      "name": "workWeek",
      "kind": "Grouping",
      "displayName": "Work Week",
      "displayNameKey": "Qaqc_role_workWeek",
      "description": "Work Week Observed for inspections, Weld Work Week for welds, for example WW42'2026.",
      "descriptionKey": "Qaqc_role_workWeek_description"
    },
    {
      "name": "phase",
      "kind": "Grouping",
      "displayName": "Inspection Phase",
      "displayNameKey": "Qaqc_role_phase",
      "description": "Final, SOR, or another inspection phase. Only finals and SORs are counted.",
      "descriptionKey": "Qaqc_role_phase_description"
    },
    {
      "name": "issue",
      "kind": "Grouping",
      "displayName": "Issue",
      "displayNameKey": "Qaqc_role_issue",
      "description": "No Issue Found, or the issue raised on the inspection; for welds, the BIM number when an issue was created.",
      "descriptionKey": "Qaqc_role_issue_description"
    },
    {
      "name": "building",
      "kind": "Grouping",
      "displayName": "Building",
      "displayNameKey": "Qaqc_role_building",
      "description": "Building or area inspected.",
      "descriptionKey": "Qaqc_role_building_description"
    },
    {
      "name": "signature",
      "kind": "Grouping",
      "displayName": "Signature",
      "displayNameKey": "Qaqc_role_signature",
      "description": "Weld QCx signature. Blank means the weld is not signed off yet.",
      "descriptionKey": "Qaqc_role_signature_description"
    },
    {
      "name": "signedWeek",
      "kind": "Grouping",
      "displayName": "Work Week Signed",
      "displayNameKey": "Qaqc_role_signedWeek",
      "description": "Work Week the weld was signed, for example WW42'2026.",
      "descriptionKey": "Qaqc_role_signedWeek_description"
    },
    {
      "name": "id",
      "kind": "Grouping",
      "displayName": "ID",
      "displayNameKey": "Qaqc_role_id",
      "description": "BIM issue ID, for example #1024.",
      "descriptionKey": "Qaqc_role_id_description"
    },
    {
      "name": "status",
      "kind": "Grouping",
      "displayName": "Status",
      "displayNameKey": "Qaqc_role_status",
      "description": "BIM issue status, for example Open, Closed or Void. Void issues are excluded.",
      "descriptionKey": "Qaqc_role_status_description"
    },
    {
      "name": "type",
      "kind": "Grouping",
      "displayName": "Type",
      "displayNameKey": "Qaqc_role_type",
      "description": "BIM issue type, for example COR, NCR or DWN. CORs and DWNs are counted in the quality strip.",
      "descriptionKey": "Qaqc_role_type_description"
    },
    {
      "name": "createdOn",
      "kind": "Grouping",
      "displayName": "Created On",
      "displayNameKey": "Qaqc_role_createdOn",
      "description": "Date the BIM issue was created. Sets the work week it was opened.",
      "descriptionKey": "Qaqc_role_createdOn_description"
    },
    {
      "name": "updatedOn",
      "kind": "Grouping",
      "displayName": "Updated On",
      "displayNameKey": "Qaqc_role_updatedOn",
      "description": "Date the BIM issue was last updated. A closed issue counts as closed on this date.",
      "descriptionKey": "Qaqc_role_updatedOn_description"
    },
    {
      "name": "createdBy",
      "kind": "Grouping",
      "displayName": "Created By",
      "displayNameKey": "Qaqc_role_createdBy",
      "description": "Who created the BIM issue. Only issues created by LotusWorks are counted.",
      "descriptionKey": "Qaqc_role_createdBy_description"
    },
    {
      "name": "rootCause",
      "kind": "Grouping",
      "displayName": "Root Cause",
      "displayNameKey": "Qaqc_role_rootCause",
      "description": "Optional. The QCx Combined Root Cause column; adds the Top root cause card.",
      "descriptionKey": "Qaqc_role_rootCause_description"
    },
    {
      "name": "bim360CreatedBy",
      "kind": "Grouping",
      "displayName": "BIM360 Created By",
      "displayNameKey": "Qaqc_role_bim360CreatedBy",
      "description": "Optional. The QCx Combined BIM360 Created By column. For an issue migrated from BIM 360, it decides whether LotusWorks created the issue.",
      "descriptionKey": "Qaqc_role_bim360CreatedBy_description"
    },
    {
      "name": "bim360CreatedOn",
      "kind": "Grouping",
      "displayName": "BIM360 Created On",
      "displayNameKey": "Qaqc_role_bim360CreatedOn",
      "description": "Optional. The QCx Combined BIM360 Created On column. A migrated issue counts as opened on this date instead of Created On.",
      "descriptionKey": "Qaqc_role_bim360CreatedOn_description"
    },
    {
      "name": "bim360ClosedOn",
      "kind": "Grouping",
      "displayName": "BIM360 Closed On",
      "displayNameKey": "Qaqc_role_bim360ClosedOn",
      "description": "Optional. The QCx Combined BIM360 Closed On column. A migrated closed issue counts as closed on this date instead of Closed At or Updated On.",
      "descriptionKey": "Qaqc_role_bim360ClosedOn_description"
    },
    {
      "name": "closedAt",
      "kind": "Grouping",
      "displayName": "Closed At",
      "displayNameKey": "Qaqc_role_closedAt",
      "description": "Optional. The QCx Combined Closed At column. A closed issue counts as closed on this date instead of Updated On.",
      "descriptionKey": "Qaqc_role_closedAt_description"
    },
    {
      "name": "generalContractor",
      "kind": "Grouping",
      "displayName": "General Contractor",
      "displayNameKey": "Qaqc_role_generalContractor",
      "description": "Optional. The QCx Combined General Contractor column. Adds Contractor to the Filter menu for inspections.",
      "descriptionKey": "Qaqc_role_generalContractor_description"
    },
    {
      "name": "contractor",
      "kind": "Grouping",
      "displayName": "Contractor",
      "displayNameKey": "Qaqc_role_contractor",
      "description": "Optional. The QCx Combined Contractor column. Adds Contractor to the Filter menu for BIM issues.",
      "descriptionKey": "Qaqc_role_contractor_description"
    },
    {
      "name": "discipline",
      "kind": "Grouping",
      "displayName": "Discipline",
      "displayNameKey": "Qaqc_role_discipline",
      "description": "Optional. The QCx Combined Discipline column. Adds Discipline to the Filter menu for inspections and BIM issues.",
      "descriptionKey": "Qaqc_role_discipline_description"
    },
    {
      "name": "tagNo",
      "kind": "Grouping",
      "displayName": "Tag No",
      "displayNameKey": "Qaqc_role_tagNo",
      "description": "Optional. The QCx Combined Tag No column. Lets the Building filter reach welds, and shows in a week's issue list.",
      "descriptionKey": "Qaqc_role_tagNo_description"
    },
    {
      "name": "welder",
      "kind": "Grouping",
      "displayName": "Welder",
      "displayNameKey": "Qaqc_role_welder",
      "description": "Optional. The QCx Combined Welder column. Shows in a week's issue list.",
      "descriptionKey": "Qaqc_role_welder_description"
    },
    {
      "name": "pipeSpec",
      "kind": "Grouping",
      "displayName": "Pipe Spec",
      "displayNameKey": "Qaqc_role_pipeSpec",
      "description": "Optional. The QCx Combined Pipe Spec column. Shows in a week's issue list.",
      "descriptionKey": "Qaqc_role_pipeSpec_description"
    },
    {
      "name": "fluidCode",
      "kind": "Grouping",
      "displayName": "Fluid Code",
      "displayNameKey": "Qaqc_role_fluidCode",
      "description": "Optional. The QCx Combined Fluid Code column. Shows in a week's issue list.",
      "descriptionKey": "Qaqc_role_fluidCode_description"
    },
    {
      "name": "inspectionId",
      "kind": "Grouping",
      "displayName": "Inspection ID",
      "displayNameKey": "Qaqc_role_inspectionId",
      "description": "Optional. The QCx Combined Inspection ID column. Shows in a week's issue list.",
      "descriptionKey": "Qaqc_role_inspectionId_description"
    },
    {
      "name": "equipmentTag",
      "kind": "Grouping",
      "displayName": "Equipment ID / Tag Number",
      "displayNameKey": "Qaqc_role_equipmentTag",
      "description": "Optional. The QCx Combined Equipment ID / Tag Number column. Shows in a week's issue list.",
      "descriptionKey": "Qaqc_role_equipmentTag_description"
    },
    {
      "name": "issueId",
      "kind": "Grouping",
      "displayName": "Issue ID",
      "displayNameKey": "Qaqc_role_issueId",
      "description": "Optional. The QCx Combined Issue ID column. Shows in a week's issue list.",
      "descriptionKey": "Qaqc_role_issueId_description"
    },
    {
      "name": "findingType",
      "kind": "Grouping",
      "displayName": "Finding Type",
      "displayNameKey": "Qaqc_role_findingType",
      "description": "Optional. The QCx Combined Finding Type column. Shows in a week's issue list.",
      "descriptionKey": "Qaqc_role_findingType_description"
    },
    {
      "name": "dateObserved",
      "kind": "Grouping",
      "displayName": "Date Observed",
      "displayNameKey": "Qaqc_role_dateObserved",
      "description": "Optional. The QCx Combined Date Observed column. Shows in a week's issue list.",
      "descriptionKey": "Qaqc_role_dateObserved_description"
    },
    {
      "name": "qcr",
      "kind": "Grouping",
      "displayName": "QCR/FE",
      "displayNameKey": "Qaqc_role_qcr",
      "description": "Optional. The QCx Combined QCR/FE column. Shows in a week's issue list.",
      "descriptionKey": "Qaqc_role_qcr_description"
    },
    {
      "name": "notes",
      "kind": "Grouping",
      "displayName": "Notes",
      "displayNameKey": "Qaqc_role_notes",
      "description": "Optional. The QCx Combined Notes column. Shows in a week's issue list.",
      "descriptionKey": "Qaqc_role_notes_description"
    },
    {
      "name": "greenTags",
      "kind": "Measure",
      "displayName": "Green tags",
      "displayNameKey": "Qaqc_role_greenTags",
      "description": "Your green tag count measure. Wrap it in COALESCE(…, 0) so a blank count never hides the data. The DWN rate is DWNs to date divided by this value.",
      "descriptionKey": "Qaqc_role_greenTags_description"
    }
