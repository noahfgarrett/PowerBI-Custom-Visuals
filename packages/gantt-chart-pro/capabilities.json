{
  "dataRoles": [
    {
      "displayName": "Task Name",
      "name": "taskName",
      "kind": "Grouping",
      "description": "Task name"
    },
    {
      "displayName": "Start Date",
      "name": "startDate",
      "kind": "Grouping",
      "description": "Task start date"
    },
    {
      "displayName": "End Date",
      "name": "endDate",
      "kind": "Grouping",
      "description": "Task end date"
    },
    {
      "displayName": "Progress (%)",
      "name": "progress",
      "kind": "Measure",
      "description": "Task completion percentage (0-100)"
    },
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Optional category for color grouping"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "taskName": {
            "max": 1
          },
          "startDate": {
            "max": 1
          },
          "endDate": {
            "max": 1
          },
          "progress": {
            "max": 1
          },
          "category": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "taskName"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 200
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "startDate"
              }
            },
            {
              "bind": {
                "to": "endDate"
              }
            },
            {
              "bind": {
                "to": "progress"
              }
            },
            {
              "bind": {
                "to": "category"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
    "ganttSettings": {
