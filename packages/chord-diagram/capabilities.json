    {
      "displayName": "Measure",
      "name": "measure",
      "kind": "Measure",
      "description": "Relationship weight/value"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "source": {
            "max": 1
          },
          "target": {
            "max": 1
          },
          "measure": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "source"
              }
            },
            {
              "for": {
                "in": "target"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 500
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            }
          ]
        }
      }
    }
  ],
