{
  "dataRoles": [
    {
      "displayName": "Date",
      "name": "date",
      "kind": "Grouping",
      "description": "Date values for calendar placement"
    },
    {
      "displayName": "Measure",
      "name": "measure",
      "kind": "Measure",
      "description": "Intensity value for each date"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "date": {
            "max": 1
          },
          "measure": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "date"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 1000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            }
          ]
        }
      }
    }
  ],
