{
  "dataRoles": [
    {
      "displayName": "Source",
      "name": "source",
      "kind": "Grouping",
      "description": "Source node name"
    },
    {
      "displayName": "Target",
      "name": "target",
      "kind": "Grouping",
      "description": "Target node name"
    },
    {
      "displayName": "Weight",
      "name": "weight",
      "kind": "Measure",
      "description": "Link weight (optional)"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "source": {
            "max": 1
          },
          "target": {
            "max": 1
          },
          "weight": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "source"
              }
            },
            {
              "for": {
                "in": "target"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 500
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "weight"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
    "forceSettings": {
      "displayName": "Force Physics",
      "properties": {
        "strength": {
          "displayName": "Link Strength",
          "type": {
            "numeric": true
