  "dataViewMappings": [
    {
      "conditions": [
        {
          "date": {
            "max": 1
          },
          "label": {
            "max": 1
          },
          "category": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "date"
              }
            },
            {
              "for": {
                "in": "label"
              }
            },
            {
              "for": {
                "in": "category"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 200
            }
          }
        }
      }
    }
