{
  "dataRoles": [
    {
      "displayName": "Date",
      "name": "date",
      "kind": "Grouping",
      "description": "Milestone date"
    },
    {
      "displayName": "Label",
      "name": "label",
      "kind": "Grouping",
      "description": "Milestone label"
    },
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Optional grouping for color"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "date": {
            "max": 1
          },
          "label": {
            "max": 1
          },
          "category": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "date"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 200
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "label"
              }
            },
            {
              "bind": {
                "to": "category"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
