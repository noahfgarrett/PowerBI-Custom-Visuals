{
  "dataRoles": [
    {
      "displayName": "Item",
      "name": "item",
      "kind": "Grouping",
      "description": "The ranked items (e.g., product names)"
    },
    {
      "displayName": "Time Axis",
      "name": "timeAxis",
      "kind": "Grouping",
      "description": "Time periods (e.g., months, quarters)"
    },
    {
      "displayName": "Measure",
      "name": "measure",
      "kind": "Measure",
      "description": "Value used to determine rank"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "item": {
            "max": 1
          },
          "timeAxis": {
            "max": 1
          },
          "measure": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "item"
              }
            },
            {
              "for": {
                "in": "timeAxis"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 1000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            }
          ]
        }
      }
    }
  ],
