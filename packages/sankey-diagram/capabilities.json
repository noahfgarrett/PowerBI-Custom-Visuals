{
  "dataRoles": [
    {
      "displayName": "Source",
      "name": "source",
      "kind": "Grouping",
      "description": "Source node category"
    },
    {
      "displayName": "Step 2",
      "name": "step2",
      "kind": "Grouping",
      "description": "Intermediate node between Source and Target"
    },
    {
      "displayName": "Step 3",
      "name": "step3",
      "kind": "Grouping",
      "description": "Second intermediate node (used with Step 2)"
    },
    {
      "displayName": "Step 4",
      "name": "step4",
      "kind": "Grouping",
      "description": "Third intermediate node (used with Step 2 and Step 3)"
    },
    {
      "displayName": "Step 5",
      "name": "step5",
      "kind": "Grouping",
      "description": "Fourth intermediate node (used with Step 2, Step 3, and Step 4)"
    },
    {
      "displayName": "Target",
      "name": "target",
      "kind": "Grouping",
      "description": "Target node category"
    },
    {
      "displayName": "Weight",
      "name": "weight",
      "kind": "Measure",
      "description": "Flow value/weight between source and target"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "source": {
            "max": 1
          },
          "step2": {
            "max": 1
          },
          "step3": {
            "max": 1
          },
          "step4": {
            "max": 1
          },
          "step5": {
            "max": 1
          },
          "target": {
            "max": 1
          },
          "weight": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "source"
              }
            },
            {
              "for": {
                "in": "step2"
              }
            },
            {
              "for": {
                "in": "step3"
              }
            },
            {
              "for": {
                "in": "step4"
              }
            },
            {
              "for": {
                "in": "step5"
              }
            },
            {
              "for": {
                "in": "target"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 1000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "weight"
              }
            }
          ]
        }
      }
    }
  ],
