{
  "dataRoles": [
    {
      "displayName": "Source",
      "name": "source",
      "kind": "Grouping",
      "description": "Source node category"
    },
    {
      "displayName": "Step 2",
      "name": "step2",
      "kind": "Grouping",
      "description": "Intermediate node between Source and Target"
    },
    {
      "displayName": "Step 3",
      "name": "step3",
      "kind": "Grouping",
      "description": "Second intermediate node (used with Step 2)"
    },
    {
      "displayName": "Target",
      "name": "target",
      "kind": "Grouping",
      "description": "Target node category"
    },
    {
      "displayName": "Weight",
      "name": "weight",
      "kind": "Measure",
      "description": "Flow value/weight between source and target"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "source": {
            "max": 1
          },
          "step2": {
            "max": 1
          },
          "step3": {
            "max": 1
          },
          "target": {
            "max": 1
          },
          "weight": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "source"
              }
            },
            {
              "for": {
                "in": "step2"
              }
            },
            {
              "for": {
                "in": "step3"
              }
            },
            {
              "for": {
                "in": "target"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 1000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "weight"
              }
            }
          ]
        }
      }
    }
  ],
