{
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Point labels for each data point"
    },
    {
      "displayName": "X Value",
      "name": "xValue",
      "kind": "Measure",
      "description": "X-axis value for each point"
    },
    {
      "displayName": "Y Value",
      "name": "yValue",
      "kind": "Measure",
      "description": "Y-axis value for each point"
    },
    {
      "displayName": "Size",
      "name": "size",
      "kind": "Measure",
      "description": "Optional bubble size dimension"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "xValue": {
            "max": 1
          },
          "yValue": {
            "max": 1
          },
          "size": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 500
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "xValue"
              }
            },
            {
              "bind": {
                "to": "yValue"
              }
            },
            {
              "bind": {
                "to": "size"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
    "scatterSettings": {
      "displayName": "Scatter Settings",
      "properties": {
        "minRadius": {
          "displayName": "Min Radius",
          "type": {
            "numeric": true
