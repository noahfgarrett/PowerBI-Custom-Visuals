{
  "dataRoles": [
    {
      "displayName": "Gauge Label",
      "name": "category",
      "kind": "Grouping",
      "description": "Category field that names each gauge"
    },
    {
      "displayName": "Value",
      "name": "measure",
      "kind": "Measure",
      "description": "Current value for each gauge",
      "requiredTypes": [
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "Target",
      "name": "target",
      "kind": "Measure",
      "description": "Optional target value for each gauge"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "measure": {
            "max": 1
          },
          "target": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 8
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            },
            {
              "bind": {
                "to": "target"
              }
            }
          ]
        }
      }
    }
  ],
