{
  "dataRoles": [
    {
      "name": "category",
      "kind": "Grouping",
      "displayName": "Category",
      "displayNameKey": "Visual_Category"
    },
    {
      "name": "measure",
      "kind": "Measure",
      "displayName": "Health Value",
      "displayNameKey": "Visual_Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "measure": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 100
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            }
          ]
        }
      }
    }
  ],
