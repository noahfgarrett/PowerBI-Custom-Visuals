{
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Row labels (e.g., department, region)"
    },
    {
      "displayName": "Start Value",
      "name": "startValue",
      "kind": "Measure",
      "description": "Start/before value (left dot)"
    },
    {
      "displayName": "End Value",
      "name": "endValue",
      "kind": "Measure",
      "description": "End/after value (right dot)"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "startValue": {
            "max": 1
          },
          "endValue": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "startValue"
              }
            },
            {
              "bind": {
                "to": "endValue"
              }
            }
          ]
        }
      }
    }
  ],
