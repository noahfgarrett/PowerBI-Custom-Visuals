            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "goodColor": {
          "displayName": "Good Color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "barColor": {
          "displayName": "Bar Color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    },
    "animationSettings": {
