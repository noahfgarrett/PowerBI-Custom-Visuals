{
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Bullet chart labels (e.g., KPI names)"
    },
    {
      "displayName": "Value",
      "name": "measure",
      "kind": "Measure",
      "description": "Actual value \u2014 the main bar"
    },
    {
      "displayName": "Target",
      "name": "target",
      "kind": "Measure",
      "description": "Target marker value"
    },
    {
      "displayName": "Poor Range",
      "name": "poor",
      "kind": "Measure",
      "description": "Upper bound of the poor range"
    },
    {
      "displayName": "Satisfactory Range",
      "name": "satisfactory",
      "kind": "Measure",
      "description": "Upper bound of the satisfactory range"
    },
    {
      "displayName": "Good Range",
      "name": "good",
      "kind": "Measure",
      "description": "Upper bound of the good range (also serves as max)"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "measure": {
            "max": 1
          },
          "target": {
            "max": 1
          },
          "poor": {
            "max": 1
          },
          "satisfactory": {
            "max": 1
          },
          "good": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 100
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            },
            {
              "bind": {
                "to": "target"
              }
            },
            {
              "bind": {
                "to": "poor"
              }
            },
            {
              "bind": {
                "to": "satisfactory"
              }
            },
            {
              "bind": {
                "to": "good"
              }
            }
          ]
        }
      }
    }
  ],
