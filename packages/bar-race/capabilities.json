{
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Items being ranked (e.g., company names)"
    },
    {
      "displayName": "Time Axis",
      "name": "timeAxis",
      "kind": "Grouping",
      "description": "Time dimension (e.g., year, month)"
    },
    {
      "displayName": "Measure",
      "name": "measure",
      "kind": "Measure",
      "description": "Value for bar length"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "timeAxis": {
            "max": 1
          },
          "measure": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            },
            {
              "for": {
                "in": "timeAxis"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 2000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            }
          ]
        }
      }
    }
  ],
