      "displayName": "Stream",
      "properties": {
        "offset": {
          "displayName": "Stack Offset",
          "type": {
            "enumeration": [
              {
                "value": "wiggle",
                "displayName": "Wiggle"
              },
              {
                "value": "silhouette",
                "displayName": "Silhouette"
