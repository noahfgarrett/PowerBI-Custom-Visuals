  "dataViewMappings": [
    {
      "conditions": [
        {
          "workWeek": { "max": 1 },
          "phase": { "max": 1 },
          "issue": { "max": 1 },
          "building": { "max": 1 },
          "rowId": { "max": 1 },
          "generalContractor": { "max": 1 },
          "tradeSupplier": { "max": 1 },
          "discipline": { "max": 1 },
          "inspectionCategory": { "max": 1 },
          "status": { "max": 1 },
          "equipmentTag": { "max": 1 },
          "issueId": { "max": 1 },
          "findingType": { "max": 1 },
          "dateObserved": { "max": 1 },
          "qcr": { "max": 1 },
          "notes": { "max": 1 }
        }
      ],
      "table": {
        "rows": {
          "select": [
            { "for": { "in": "workWeek" } },
            { "for": { "in": "phase" } },
            { "for": { "in": "issue" } },
            { "for": { "in": "building" } },
            { "for": { "in": "rowId" } },
            { "for": { "in": "generalContractor" } },
            { "for": { "in": "tradeSupplier" } },
            { "for": { "in": "discipline" } },
            { "for": { "in": "inspectionCategory" } },
            { "for": { "in": "status" } },
            { "for": { "in": "equipmentTag" } },
            { "for": { "in": "issueId" } },
            { "for": { "in": "findingType" } },
            { "for": { "in": "dateObserved" } },
            { "for": { "in": "qcr" } },
            { "for": { "in": "notes" } }
          ],
          "dataReductionAlgorithm": {
            "window": { "count": 30000 }
          }
        }
      }
    }
  ],
  "objects": {
    "colors": {
      "displayName": "Colors",
      "displayNameKey": "Qaqc_colors",
      "properties": {
        "preset": {
          "displayName": "Preset",
          "displayNameKey": "Qaqc_colors_preset",
          "type": {
            "enumeration": [
              { "value": "qaqc", "displayName": "QCx", "displayNameKey": "Qaqc_preset_qaqc" },
              { "value": "blue", "displayName": "Blue", "displayNameKey": "Qaqc_preset_blue" },
              { "value": "lotusworks", "displayName": "LotusWorks", "displayNameKey": "Qaqc_preset_lotusworks" },
              { "value": "grayscale", "displayName": "Grayscale", "displayNameKey": "Qaqc_preset_grayscale" }
            ]
          }
        }
      }
    },
    "cardSettings": {
      "displayName": "Background",
      "displayNameKey": "Qaqc_background",
      "properties": {
        "backgroundColor": {
          "displayName": "Background color",
          "displayNameKey": "Qaqc_background_color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "backgroundOpacity": {
          "displayName": "Background opacity",
          "displayNameKey": "Qaqc_background_opacity",
          "type": { "numeric": true }
        },
        "cardOpacity": {
          "displayName": "Card opacity",
          "displayNameKey": "Qaqc_card_opacity",
          "type": { "numeric": true }
        }
      }
    },
    "animationSettings": {
      "displayName": "Animation",
      "displayNameKey": "Qaqc_animation",
      "properties": {
        "enabled": {
          "displayName": "Transitions",
          "displayNameKey": "Qaqc_animation_enabled",
          "type": { "bool": true }
        }
      }
    },
    "accessibility": {
      "displayName": "Accessibility",
      "displayNameKey": "Qaqc_accessibility",
      "properties": {
        "chartSummaries": {
          "displayName": "Screen reader chart summaries",
          "displayNameKey": "Qaqc_accessibility_summaries",
          "type": { "bool": true }
        }
      }
    }
  },
  "tooltips": {
    "supportedTypes": { "default": true },
    "supportEnhancedTooltips": true
  },
  "supportsEmptyDataView": true,
  "supportsKeyboardFocus": true,
  "privileges": []
}
