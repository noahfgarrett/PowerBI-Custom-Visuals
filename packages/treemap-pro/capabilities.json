      "displayNameKey": "TreemapProCapabilities_DisplayName_0003",
      "descriptionKey": "TreemapProCapabilities_Description_0003"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "level1": {
            "max": 1
          },
          "level2": {
            "max": 1
          },
          "measure": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "level1"
              }
            },
            {
              "for": {
                "in": "level2"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            }
          ]
        }
      }
    }
  ],
