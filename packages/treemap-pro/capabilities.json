{
  "dataRoles": [
    {
      "displayName": "Level 1",
      "name": "level1",
      "kind": "Grouping",
      "description": "Top-level category grouping"
    },
    {
      "displayName": "Level 2",
      "name": "level2",
      "kind": "Grouping",
      "description": "Sub-category grouping (optional)"
    },
    {
      "displayName": "Measure",
      "name": "measure",
      "kind": "Measure",
      "description": "Size value for treemap rectangles"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "level1": {
            "max": 1
          },
          "level2": {
            "max": 1
          },
          "measure": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "level1"
              }
            },
            {
              "for": {
                "in": "level2"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 1000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            }
          ]
        }
      }
    }
  ],
