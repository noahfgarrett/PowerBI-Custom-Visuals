{
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Item labels (e.g., product names)"
    },
    {
      "displayName": "Start Value",
      "name": "startMeasure",
      "kind": "Measure",
      "description": "Start/left column value"
    },
    {
      "displayName": "End Value",
      "name": "endMeasure",
      "kind": "Measure",
      "description": "End/right column value"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "startMeasure": {
            "max": 1
          },
          "endMeasure": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "category"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 20
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "startMeasure"
              }
            },
            {
              "bind": {
                "to": "endMeasure"
              }
            }
          ]
        }
      }
    }
  ],
