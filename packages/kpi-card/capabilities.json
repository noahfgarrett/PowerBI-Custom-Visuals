{
  "dataRoles": [
    {
      "displayName": "Value",
      "name": "measure",
      "kind": "Measure",
      "description": "The main KPI value to display"
    },
    {
      "displayName": "Target",
      "name": "target",
      "kind": "Measure",
      "description": "Target or comparison value for trend calculation"
    },
    {
      "displayName": "Trend Axis",
      "name": "trendAxis",
      "kind": "Grouping",
      "description": "Category axis for the sparkline (e.g., date, week)"
    },
    {
      "displayName": "Trend Values",
      "name": "trendValues",
      "kind": "Measure",
      "description": "Values for the sparkline trend line"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "measure": {
            "max": 1
          },
          "target": {
            "max": 1
          },
          "trendAxis": {
            "max": 1
          },
          "trendValues": {
            "max": 1
          }
        }
      ],
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "trendAxis"
              }
            },
            {
              "for": {
                "in": "measure"
              }
            },
            {
              "for": {
                "in": "target"
              }
            },
            {
              "for": {
                "in": "trendValues"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 100
            }
          }
        }
      }
    }
  ],
  "objects": {
    "valueSettings": {
      "displayName": "Value",
      "properties": {
        "fontSize": {
