  "dataViewMappings": [
    {
      "conditions": [
        {
          "measure": {
            "max": 1
          },
          "target": {
            "max": 1
          },
          "trendAxis": {
            "max": 1
          },
          "trendValues": {
            "max": 1
          }
        }
      ],
      "table": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "trendAxis"
              }
            },
            {
              "for": {
                "in": "measure"
              }
            },
            {
              "for": {
                "in": "target"
              }
            },
            {
              "for": {
                "in": "trendValues"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 100
            }
          }
        }
      }
    }
