{
  "name": "pbi-custom-visuals",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preview": "cd preview && npx vite",
    "preview:build": "cd preview && npx vite build",
    "postinstall": "node scripts/link-visuals-api.mjs",
    "build:all": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "review:business": "node scripts/review-business-package.mjs",
    "sync:business": "node scripts/sync-business-package.mjs",
    "package:business": "npm run build:all && npm run sync:business",
    "qa:business": "npm run typecheck && npm run review:business",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  }
}
